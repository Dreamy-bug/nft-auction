# 私钥（用于部署和升级合约，请勿提交到版本控制）
PRIVATE_KEY=your_private_key_here

# RPC节点地址
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/your_api_key
MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/your_api_key

# Etherscan API密钥（用于合约验证）
ETHERSCAN_API_KEY=your_etherscan_api_key

# Chainlink Price Feed地址（Sepolia测试网）
# ETH/USD: https://docs.chain.link/data-feeds/price-feeds/addresses?network=ethereum&page=1&search=eth+usd
ETH_USD_PRICE_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306

# 手续费接收地址
FEE_RECIPIENT=0xYourFeeRecipientAddress

# 代理合约地址（部署后填写，升级时使用）
PROXY_ADDRESS=0xYourProxyAddress
